# Base URL of the Laravel API, without a trailing slash.
# Leave empty in development: Vite proxies /api, /sanctum and /storage to DEV_BACKEND_URL.
# Production example: VITE_API_URL=https://api.example.lk
VITE_API_URL=

# Public URL of this website (canonical links, Open Graph URLs). No trailing slash.
VITE_SITE_URL=http://localhost:5173

# Development only: where the Laravel API runs
DEV_BACKEND_URL=http://localhost:8000

