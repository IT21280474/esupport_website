APP_NAME="Muthumala Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public React site (used for CORS, password-reset links, sitemap and canonical URLs)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muthumala_group
DB_USERNAME=
DB_PASSWORD=

# Admin sessions (Sanctum SPA cookie auth).
# In production the SPA and API must share a parent domain, e.g. www.example.lk + api.example.lk:
#   SESSION_DOMAIN=.example.lk
#   SANCTUM_STATEFUL_DOMAINS=www.example.lk,example.lk
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail — notification recipients are configured in Admin → Settings → Notifications
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial super-admin account created by `php artisan db:seed` (change the password after first login)
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
